<Window x:Class="ClaudeVoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Voice - AI Transcription" Height="600" Width="900"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <StackPanel>
                <TextBlock Text="Claude Voice Transcription"
                          Foreground="White"
                          FontSize="24"
                          FontWeight="Bold"
                          Margin="0"/>
                <TextBlock x:Name="StatusText"
                          Text="Ready to record"
                          Foreground="#BDC3C7"
                          FontSize="12"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Transcription Display -->
        <ScrollViewer Grid.Row="1"
                     VerticalScrollBarVisibility="Auto"
                     Margin="10"
                     Background="White">
            <WrapPanel x:Name="TranscriptionPanel"
                      Margin="10"
                      Orientation="Horizontal">
                <!-- Words will be added here dynamically -->
            </WrapPanel>
        </ScrollViewer>

        <!-- Control Panel -->
        <Border Grid.Row="2" Background="White" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="RecordButton"
                       Content="🎙️ Start Recording"
                       Grid.Column="0"
                       Background="#27AE60"
                       Foreground="White"
                       BorderThickness="0"
                       Padding="20,10"
                       Click="RecordButton_Click"/>

                <Button x:Name="StopButton"
                       Content="⏹️ Stop"
                       Grid.Column="1"
                       Background="#E74C3C"
                       Foreground="White"
                       BorderThickness="0"
                       Padding="20,10"
                       IsEnabled="False"
                       Click="StopButton_Click"/>

                <Button x:Name="ClearButton"
                       Content="🗑️ Clear"
                       Grid.Column="2"
                       Background="#95A5A6"
                       Foreground="White"
                       BorderThickness="0"
                       Padding="20,10"
                       Click="ClearButton_Click"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBlock Text="MCP Server:"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                    <Ellipse x:Name="McpStatusIndicator"
                            Width="12"
                            Height="12"
                            Fill="#E74C3C"
                            VerticalAlignment="Center"
                            ToolTip="MCP Server Offline"/>
                    <TextBlock x:Name="McpStatusText"
                              Text="Offline"
                              VerticalAlignment="Center"
                              Margin="5,0,0,0"
                              Foreground="#7F8C8D"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
